# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FONNTE_TOKEN: Token for sending WA messages
FONNTE_TOKEN="YPwfsqYPBujo7yD4gGoU"

# FONNTE_GROUP_ID: Default WhatsApp group target ID
FONNTE_GROUP_ID="6285755485115-1419913594@g.us"
-e 
# VITE_GOOGLE_CLIENT_ID: Required for Google Drive OAuth.
VITE_GOOGLE_CLIENT_ID=""

# cPanel / MySQL Database Configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="cpanel_dbuser"
DB_PASSWORD="your_secure_password"
DB_NAME="cpanel_schoolsaas"

# JWT Authentication Secret
JWT_SECRET="schoolsaas_jwt_secret_change_in_production"
