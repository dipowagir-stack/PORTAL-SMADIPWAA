rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; 
      // Note: Full ownership validation typically requires querying Firestore,
      // but standard Storage rules can at least verify auth. 
      // To strictly enforce: ownerId == request.auth.uid for users, 
      // or for applicants, since ownerId is applicantId, we rely on the service layer.
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
